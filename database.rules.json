{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['ts']) && newData.child('ts').isNumber()",
        "ts": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
